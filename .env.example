# Скопируйте в .env для локальной разработки.
# На Railway задайте те же ключи в Variables каждого сервиса.
# Не помещайте этот файл с реальными секретами в git.

# --- Общее ---
NODE_ENV=development
# Часовой пояс департамента, минуты от UTC. 180 = Москва.
TZ_OFFSET_MINUTES=180

# --- PostgreSQL ---
# Railway подставляет DATABASE_URL автоматически, если связать сервис Postgres с API и ботом.
DATABASE_URL=postgresql://mdt:mdt@localhost:5432/mdt?schema=public

# --- API ---
PORT=3000
# Публичный HTTPS-адрес API. Он же является базой Redirect URI:
# {API_PUBLIC_URL}/api/auth/discord/callback
API_PUBLIC_URL=http://localhost:3000
# Случайная длинная строка. Обязательна в production. Соль хешей сессий.
SESSION_PEPPER=change-me-to-a-long-random-string
# Срок сессии в часах.
SESSION_HOURS=24
# Максимальный срок жизни сессии без повторного входа, в днях.
SESSION_ABSOLUTE_DAYS=14

# --- Discord OAuth2 (только сервер, никогда не класть в Electron) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# identify достаточно для входа.
DISCORD_OAUTH_SCOPES=identify

# Discord ID администраторов через запятую. При первом входе им выдаётся роль administrator.
# Это единственный способ создать первого администратора. Не используйте вымышленные ID.
BOOTSTRAP_DISCORD_IDS=

# Локальный вход тестовыми персонажами TEST-DISCORD-*.
# В production процесс API откажется запускаться, если флаг включён.
ALLOW_DEV_LOGIN=false

# --- Discord-бот (сервис mdt-bot) ---
DISCORD_BOT_TOKEN=
# Необязательно. Если задан, slash-команды регистрируются сразу на этом сервере.
DISCORD_GUILD_ID=
# Адрес API для команды /mdt-status. Во внутренней сети Railway можно указать публичный URL API.
API_HEALTH_URL=http://localhost:3000/health

# Ссылка, которую бот добавляет в сообщения. Для настольного приложения оставьте пустым:
# бот напишет «Откройте MDT». Если позже появится веб-адрес, укажите его здесь.
MDT_PUBLIC_URL=

# --- Клиент Electron (встраивается на этапе сборки, это не секрет) ---
# Файл apps/desktop/.env.development и apps/desktop/.env.production
# VITE_API_URL=http://localhost:3000
# VITE_API_URL=https://your-mdt-api.up.railway.app

# --- Резервные копии ---
# Каталог необязателен. Кнопка в админ-панели отдаёт JSON в браузер/приложение.
BACKUP_DIR=

# --- Обновления Windows-приложения ---
# Каталог, откуда API отдаёт установщик. На Railway примонтируйте том в /data
# и задайте UPDATES_DIR=/data/updates, иначе файл пропадёт при следующем деплое.
UPDATES_DIR=
